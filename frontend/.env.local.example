# ===========================================
# Vedic Jyotish Frontend — Environment Config
# ===========================================
# Copy this file to .env.local and fill in your values.

# --- Backend Connection (via secure Next.js server proxy) ---
# Target backend URL for the server proxy (Rust or Python API)
BACKEND_URL=http://127.0.0.1:7860

# Secret API Key to authenticate with backend (server-only, never exposed to browser)
API_SECRET_KEY=your_api_secret_key_here

# Optional: Set this ONLY if you need client browsers to bypass the Next.js server proxy
# and connect directly to an external backend (e.g. Hugging Face Space).
# NEXT_PUBLIC_API_URL=https://your-space.hf.space
