# ============================================
# VedicJyotish Rust Backend — Environment Config
# ============================================

# --- Required ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Security ---
# 64-char API key for authenticating frontend/mobile clients
API_SECRET_KEY=your_api_secret_key_here

# --- Deployment ---
# Set to "production" to enforce API key auth and reduce log verbosity
ENVIRONMENT=development

# Comma-separated list of allowed frontend URLs (CORS)
# Example: http://localhost:3000,https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# --- Optional ---
GEMINI_MODEL=gemini-2.5-flash
MAX_QUESTIONS=3
PORT=7860

# --- Paths (auto-detected if not set) ---
# LOCATION_DB_PATH=data/locations.db
# SWISS_EPHE_PATH=../backend/ephe
