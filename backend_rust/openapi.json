{
  "openapi": "3.0.0",
  "info": {
    "title": "VedicJyotish Rust Backend API",
    "description": "High-performance, modular Vedic Astrology API powered by Rust, Axum, Swiss Ephemeris, and vedic_core. Full support for birth chart calculations, divisional vargas (D1..D60), Shadbala, Bhava Chalit cusps, Upagrahas, Jaimini Arudhas, Vimshottari and Chara Dashas, Ashtakavarga reductions, Panchangam calendars, Muhurtha electional astrology, Kundali Milan matching, and Gemini AI streaming consultations.",
    "version": "0.2.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7860",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "API Health & Metadata",
        "description": "Returns backend engine version, operational status, and documentation links.",
        "responses": {
          "200": {
            "description": "API is online",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Vedic Astrology API is running" },
                    "status": { "type": "string", "example": "online" },
                    "engine": { "type": "string", "example": "rust-swiss-eph" },
                    "version": { "type": "string", "example": "0.2.0" },
                    "documentation": { "type": "string", "example": "https://github.com/Dhruvil-8/VedicJyotish" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/search_city": {
      "get": {
        "summary": "City Atlas Lookup",
        "description": "Performs prefix query against the local SQLite GeoNames database to retrieve matching cities with geographical coordinates and timezone offsets.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "City prefix query (minimum 3 characters)",
            "schema": { "type": "string", "minLength": 3 }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching cities sorted by population rank",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/CityResult" }
                }
              }
            }
          },
          "422": { "description": "Query string too short (< 3 characters)" }
        }
      }
    },
    "/calculate_chart": {
      "post": {
        "summary": "Basic Birth Chart Calculation",
        "description": "Calculates core planetary longitudes, D1 rasi chart, D9 navamsa chart, planetary aspects, and detected classical yogas.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BirthData" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Calculated planetary positions, D1/D9 houses, and Vimshottari intervals",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChartResponse" }
              }
            }
          }
        }
      }
    },
    "/calculate_transits": {
      "post": {
        "summary": "Planetary Transit (Gochara) & Sade Sati",
        "description": "Calculates real-time planetary transits relative to natal Lagna and natal Moon positions, with active Sade Sati phase detection.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["birth_data", "transit_date", "transit_time"],
                "properties": {
                  "birth_data": { "$ref": "#/components/schemas/BirthData" },
                  "transit_date": { "type": "string", "example": "24/10/2026" },
                  "transit_time": { "type": "string", "example": "12:00" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transit planetary coordinates, Gochara houses, and Sade Sati status",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TransitResponse" }
              }
            }
          }
        }
      }
    },
    "/calculate_calendar": {
      "post": {
        "summary": "Monthly Vedic Panchangam Calendar",
        "description": "Calculates monthly calendars across Gregorian, Amanta, and Purnimanta lunar systems with Adhik/Nija masa detection.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MonthCalendarRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Monthly calendar days, Tithis, Nakshatras, and festival markings",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MonthCalendarResponse" }
              }
            }
          }
        }
      }
    },
    "/calculate_muhurtha": {
      "post": {
        "summary": "Electional Muhurtha Scoring",
        "description": "Evaluates electional timing for activities (marriage, business, travel, medical, property, general) with Panchanga snapshot, Tarabala, Chandrabala, and Disha Shoola.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MuhurthaRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Auspiciousness score, timing slots, doshas, and recommendation",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MuhurthaResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/muhurtha": {
      "post": {
        "summary": "Electional Muhurtha Scoring (v1 Endpoint)",
        "description": "Versioned alias of /calculate_muhurtha.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MuhurthaRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Auspiciousness score, timing slots, doshas, and recommendation",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MuhurthaResponse" }
              }
            }
          }
        }
      }
    },
    "/generate_report": {
      "post": {
        "summary": "AI Astrological Report (SSE Stream)",
        "description": "Streams a comprehensive 3-page celestial analysis report from Gemini via Server-Sent Events (SSE).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Chart response object with optional language specification"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-Sent Events streaming real-time tokens",
            "content": { "text/event-stream": {} }
          }
        }
      }
    },
    "/chat_with_astrologer": {
      "post": {
        "summary": "Conversational AI Astrologer (SSE Stream)",
        "description": "Streams an interactive consultation from Gemini incorporating multi-turn chat history and dynamic topic filters.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChatRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-Sent Events streaming astrologer answer tokens",
            "content": { "text/event-stream": {} }
          }
        }
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "summary": "Engine Capabilities & Metadata",
        "description": "Returns supported Ayanamsas, House Systems, Dasha Year conventions, and active calculation modules.",
        "responses": {
          "200": {
            "description": "Engine feature matrix",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CapabilityResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/chart/full": {
      "post": {
        "summary": "Enterprise Full Chart Calculation",
        "description": "Calculates complete Vedic parameters including Five-fold friendships, Vaisheshikamsa counts, Bhava Chalit cusps, Upagrahas, full Ashtakavarga with Trikona/Ekadhipatya reductions and Shodhya Pindas, and all 12 Bhava Arudhas.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChartCalculationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete birth chart structure",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChartResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/chart-context": {
      "post": {
        "summary": "AI Chart Context Generator",
        "description": "Formats calculated chart data into a compact, structured Markdown/JSON payload optimized for LLM prompt ingestion with privacy protection.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChartCalculationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured AI chart context",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AiChartContext" }
              }
            }
          }
        }
      }
    },
    "/api/v1/match/compatibility": {
      "post": {
        "summary": "Kundali Milan / Relationship Compatibility",
        "description": "Computes 36-point Ashta Koota matching with Mahendra, Stree Deergha, and dosha mitigations.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["boy", "girl"],
                "properties": {
                  "boy": { "$ref": "#/components/schemas/BirthData" },
                  "girl": { "$ref": "#/components/schemas/BirthData" },
                  "method": { "type": "string", "default": "North", "enum": ["North", "South"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ashta Koota score, koota breakdown, and dosha exceptions",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CompatibilityResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/chart/rasi": {
      "post": {
        "summary": "Rasi (D1) Chart Calculation",
        "description": "Calculates primary natal birth chart (D1) planetary positions and house distributions.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChartCalculationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rasi ascendant, house data, and planetary table",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RasiChartResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/chart/navamsa": {
      "post": {
        "summary": "Navamsa (D9) Chart Calculation",
        "description": "Calculates the ninth divisional chart (Navamsa / D9) for marriage, dharma, and planetary dignity verification.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChartCalculationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Navamsa ascendant sign and house distributions",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NavamsaChartResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/chart/varga": {
      "post": {
        "summary": "Targeted Divisional Chart (D2..D60)",
        "description": "Calculates a specific divisional chart (e.g. D2 Hora, D3 Drekkana, D7 Saptamsa, D10 Dasamsa, D12 Dwadasamsa, D16 Shodasamsa, D20 Vimsamsa, D24 Chaturvimsamsa, D27 Saptavimsamsa, D30 Trimsamsa, D40 Khavedamsa, D45 Akshavedamsa, D60 Shashtiamsa).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VargaCalculationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Targeted divisional chart structure",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VargaChartResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/chart/yogas": {
      "post": {
        "summary": "Planetary Yogas Detection",
        "description": "Detects over 300+ Parashari, Nabhasa, Raja, Dhana, and Sannyasa yogas.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChartCalculationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "List of detected yogas with names, descriptions, and categories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Yoga" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chart/doshas": {
      "post": {
        "summary": "Astrological Dosha Evaluation",
        "description": "Evaluates classical astrological doshas: Manglik (Kuja), Kaal Sarp, Pitra, and Sade Sati with classical cancellation exceptions.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChartCalculationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Detailed dosha evaluation with severity and remedies",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DoshaResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/chart/jaimini": {
      "post": {
        "summary": "Jaimini Astrological Parameters",
        "description": "Computes 7 Chara Karakas, all 12 Bhava Arudhas (A1 through A12), and Special Lagnas (Hora Lagna, Ghati Lagna, Sree Lagna, Indu Lagna).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChartCalculationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Jaimini Karakas, Arudhas, and Special Lagnas",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JaiminiResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/chart/argala": {
      "post": {
        "summary": "Jaimini Argala Solver",
        "description": "Solves planetary interventions (Argala) and obstructions (Virodhargala) relative to all 12 houses and grahas.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChartCalculationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Argala and Virodhargala maps per house and planet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ArgalaResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/chart/panchanga": {
      "post": {
        "summary": "Natal Birth Panchanga",
        "description": "Calculates the five limbs of time at birth: Vara, Tithi, Nakshatra, Yoga, and Karana with sunrise/sunset metadata.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChartCalculationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Birth Panchanga details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Panchanga" }
              }
            }
          }
        }
      }
    },
    "/api/v1/chart/ashtakavarga": {
      "post": {
        "summary": "Ashtakavarga with Classical Reductions",
        "description": "Calculates BAV, SAV, Trikona Shodhana, Ekadhipatya Shodhana, and Shodhya Pindas (Rasi Pinda, Graha Pinda, Shodhya Pinda).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChartCalculationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ashtakavarga grids and Shodhya Pinda totals",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AshtakavargaResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/chart/dasha": {
      "post": {
        "summary": "Vimshottari Dasha Timeline",
        "description": "Calculates 3-level Vimshottari Dasha hierarchy (Maha Dasha, Antar Dasha, and Pratyantar Dasha) across the 120-year cycle.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChartCalculationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Array of Maha Dashas and their sub-periods",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/MahaDasha" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chart/dasha/chara": {
      "post": {
        "summary": "Jaimini Chara Dasha Timeline",
        "description": "Computes the chronological sign-based Chara Dasha timeline applying dual-lord strength tie-breakers.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChartCalculationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sign-based timing timeline and progression",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CharaDashaResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/chart/drishti": {
      "post": {
        "summary": "Aspects (Graha Drishti & Rasi Drishti)",
        "description": "Computes planetary mutual aspects (Graha Drishti) and sign-based aspects (Jaimini Rasi Drishti).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChartCalculationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Planetary and sign aspects matrix",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DrishtiResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BirthData": {
        "type": "object",
        "required": ["date", "time", "city"],
        "properties": {
          "date": { "type": "string", "description": "DD/MM/YYYY or YYYY-MM-DD", "example": "24/10/1990" },
          "time": { "type": "string", "description": "HH:MM (24-hour)", "example": "14:30" },
          "city": { "type": "string", "description": "Birth city name", "example": "New Delhi" },
          "lat": { "type": "number", "description": "Optional latitude override", "example": 28.6139 },
          "lon": { "type": "number", "description": "Optional longitude override", "example": 77.2090 },
          "timezone": { "type": "number", "description": "Optional timezone offset override in hours", "example": 5.5 }
        }
      },
      "CalculationProfile": {
        "type": "object",
        "properties": {
          "ayanamsa": {
            "type": "string",
            "default": "Lahiri",
            "enum": [
              "Lahiri",
              "Raman",
              "KP",
              "Krishnamurti",
              "Yukteshwar",
              "TrueChitra",
              "TruePushya",
              "SuryaSiddhanta",
              "FaganBradley",
              "Tropical"
            ]
          },
          "node_type": {
            "type": "string",
            "default": "Mean",
            "enum": ["Mean", "True"]
          },
          "house_system": {
            "type": "string",
            "default": "WholeSign",
            "enum": [
              "WholeSign",
              "Equal",
              "Sripati",
              "Placidus",
              "Koch",
              "Campanus",
              "Regiomontanus",
              "Porphyry"
            ]
          },
          "dasha_year": {
            "type": "string",
            "default": "Sidereal365.256363004",
            "enum": [
              "Sidereal365.256363004",
              "Savana360",
              "Tropical365.24219"
            ]
          }
        }
      },
      "ChartCalculationRequest": {
        "type": "object",
        "required": ["birth_data"],
        "properties": {
          "birth_data": { "$ref": "#/components/schemas/BirthData" },
          "profile": { "$ref": "#/components/schemas/CalculationProfile" }
        }
      },
      "VargaCalculationRequest": {
        "type": "object",
        "required": ["birth_data", "varga_type"],
        "properties": {
          "birth_data": { "$ref": "#/components/schemas/BirthData" },
          "varga_type": { "type": "string", "example": "D10", "description": "Divisional chart type: D2, D3, D7, D9, D10, D12, D16, D20, D24, D27, D30, D40, D45, D60" },
          "profile": { "$ref": "#/components/schemas/CalculationProfile" }
        }
      },
      "MuhurthaRequest": {
        "type": "object",
        "required": ["date", "time", "lat", "lon", "timezone"],
        "properties": {
          "date": { "type": "string", "example": "24/10/2026", "description": "DD/MM/YYYY" },
          "time": { "type": "string", "example": "10:30", "description": "HH:MM" },
          "lat": { "type": "number", "example": 28.6139 },
          "lon": { "type": "number", "example": 77.2090 },
          "timezone": { "type": "number", "example": 5.5 },
          "activity": { "type": "string", "default": "general", "enum": ["general", "travel", "business", "marriage", "property", "medical"] },
          "direction": { "type": "string", "example": "north", "enum": ["east", "west", "north", "south"] },
          "birth_moon_nakshatra": { "type": "string", "example": "Rohini" },
          "birth_moon_sign": { "type": "string", "example": "Taurus" }
        }
      },
      "MuhurthaResponse": {
        "type": "object",
        "properties": {
          "activity": { "type": "string" },
          "score": { "type": "integer", "example": 85 },
          "quality": { "type": "string", "example": "Auspicious" },
          "is_auspicious": { "type": "boolean", "example": true },
          "date": { "type": "string" },
          "time": { "type": "string" },
          "panchanga": { "type": "object" },
          "slots": { "type": "object" },
          "disha_shoola": { "type": "object" },
          "tarabala": { "type": "object" },
          "chandrabala": { "type": "object" },
          "positive_factors": { "type": "array", "items": { "type": "string" } },
          "negative_factors": { "type": "array", "items": { "type": "string" } },
          "rules_applied": { "type": "array", "items": { "type": "string" } },
          "reasons": { "type": "array", "items": { "type": "string" } },
          "recommendation": { "type": "string" },
          "active_rahu_kalam": { "type": "boolean" },
          "in_abhijit": { "type": "boolean" },
          "in_brahma_muhurta": { "type": "boolean" },
          "shoola_warning": { "type": "string" },
          "shoola_mitigation": { "type": "string" }
        }
      },
      "MonthCalendarRequest": {
        "type": "object",
        "required": ["year", "lat", "lon"],
        "properties": {
          "year": { "type": "integer", "example": 2026 },
          "month": { "type": "integer", "example": 10 },
          "lat": { "type": "number", "example": 28.6139 },
          "lon": { "type": "number", "example": 77.2090 },
          "timezone": { "type": "number", "example": 5.5 },
          "tradition": { "type": "string", "enum": ["amanta", "purnimanta"], "default": "amanta" },
          "view_mode": { "type": "string", "default": "gregorian" },
          "lunar_masa": { "type": "integer" },
          "masa_type": { "type": "string" },
          "is_adhik": { "type": "boolean" }
        }
      },
      "MonthCalendarResponse": {
        "type": "object",
        "properties": {
          "year": { "type": "integer" },
          "month": { "type": "integer" },
          "days": { "type": "array", "items": { "type": "object" } },
          "metadata": { "type": "object" }
        }
      },
      "CityResult": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "New Delhi, DL, IN" },
          "lat": { "type": "number", "example": 28.6139 },
          "lon": { "type": "number", "example": 77.2090 }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": ["role", "text"],
        "properties": {
          "role": { "type": "string", "enum": ["user", "model"] },
          "text": { "type": "string" }
        }
      },
      "ChatRequest": {
        "type": "object",
        "required": ["chart_data", "question"],
        "properties": {
          "chart_data": { "type": "object" },
          "question": { "type": "string", "maxLength": 5000 },
          "history": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChatMessage" },
            "default": []
          }
        }
      },
      "ChartResponse": {
        "type": "object",
        "properties": {
          "birth_date": { "type": "string" },
          "birth_time": { "type": "string" },
          "profile": { "$ref": "#/components/schemas/CalculationProfile" },
          "ascendant": {
            "type": "object",
            "properties": {
              "sign": { "type": "string" },
              "degree": { "type": "number" }
            }
          },
          "planetary_table": { "type": "array", "items": { "type": "object" } },
          "vimshottari_timeline": { "type": "array", "items": { "$ref": "#/components/schemas/MahaDasha" } },
          "bhava_cusps": { "type": "array", "items": { "type": "object" } },
          "upagrahas": { "type": "array", "items": { "type": "object" } },
          "ashtakavarga": { "$ref": "#/components/schemas/AshtakavargaResponse" },
          "jaimini": { "$ref": "#/components/schemas/JaiminiResponse" },
          "panchanga": { "$ref": "#/components/schemas/Panchanga" },
          "shadbala": { "type": "object" },
          "yogas": { "type": "array", "items": { "$ref": "#/components/schemas/Yoga" } },
          "doshas": { "$ref": "#/components/schemas/DoshaResponse" }
        }
      },
      "TransitResponse": {
        "type": "object",
        "properties": {
          "transit_date": { "type": "string" },
          "transit_time": { "type": "string" },
          "natal_ascendant": { "type": "object" },
          "natal_moon_sign": { "type": "string" },
          "planets": { "type": "array", "items": { "type": "object" } },
          "sade_sati": { "type": "object" }
        }
      },
      "CompatibilityResponse": {
        "type": "object",
        "properties": {
          "total_score": { "type": "number", "example": 28.0 },
          "max_score": { "type": "number", "example": 36.0 },
          "percentage": { "type": "number", "example": 77.78 },
          "kootas": { "type": "object" },
          "doshas": { "type": "object" },
          "recommendation": { "type": "string" }
        }
      },
      "RasiChartResponse": {
        "type": "object",
        "properties": {
          "ascendant": { "type": "object" },
          "chart_data": { "type": "object" },
          "planetary_table": { "type": "array", "items": { "type": "object" } }
        }
      },
      "NavamsaChartResponse": {
        "type": "object",
        "properties": {
          "navamsa_ascendant_sign": { "type": "string" },
          "navamsa_chart": { "type": "object" }
        }
      },
      "VargaChartResponse": {
        "type": "object",
        "properties": {
          "varga_type": { "type": "string" },
          "ascendant_sign": { "type": "string" },
          "chart_data": { "type": "object" },
          "planets": { "type": "array", "items": { "type": "object" } }
        }
      },
      "Yoga": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "planets_involved": { "type": "array", "items": { "type": "string" } }
        }
      },
      "DoshaResponse": {
        "type": "object",
        "properties": {
