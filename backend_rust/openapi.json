          "upapada_lagna": { "type": "object" },
          "arudha_padas": { "type": "object" },
          "special_lagnas": { "type": "object" }
        }
      },
      "ArgalaResponse": {
        "type": "object",
        "properties": {
          "argala": { "type": "object" },
          "virodhargala": { "type": "object" }
        }
      },
      "Panchanga": {
        "type": "object",
        "properties": {
          "vara": { "type": "object" },
          "tithi": { "type": "object" },
          "nakshatra": { "type": "object" },
          "yoga": { "type": "object" },
          "karana": { "type": "object" }
        }
      },
      "AshtakavargaResponse": {
        "type": "object",
        "properties": {
          "bav": { "type": "object" },
          "sav": { "type": "object" },
          "trikona_shodhana": { "type": "object" },
          "ekadhipatya_shodhana": { "type": "object" },
          "shodhya_pindas": { "type": "object" }
        }
      },
      "MahaDasha": {
        "type": "object",
        "properties": {
          "lord": { "type": "string" },
