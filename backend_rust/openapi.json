      "AiChartContext": {
        "type": "object",
        "properties": {
          "chart_summary": { "type": "string" },
          "astrological_facts": { "type": "object" },
          "focus_areas": { "type": "object" }
        }
      },
      "CapabilityResponse": {
        "type": "object",
        "properties": {
          "ayanamsas": { "type": "array", "items": { "type": "string" } },
          "house_systems": { "type": "array", "items": { "type": "string" } },
          "node_types": { "type": "array", "items": { "type": "string" } },
          "dasha_year_types": { "type": "array", "items": { "type": "string" } },
          "endpoints": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
